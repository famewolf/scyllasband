<?xml version="1.0" encoding="utf-8"?>
<!-- Scylla's Band launcher foreground: a stylized lyre/harp with a musical note,
     representing a "band" (instrument) that produces voice/audio. Centered glyph
     inside the adaptive-icon safe zone. White on transparent. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- Harp frame: two curved arms rising from a base -->
    <path android:fillColor="#FFFFFF" android:pathData="
        M40,74
        C40,60 44,48 54,44
        C64,48 68,60 68,74
        L63,74
        C63,62 60,53 54,50
        C48,53 45,62 45,74
        Z"/>

    <!-- Harp strings: four vertical strings between the arms -->
    <path android:fillColor="#FFFFFF" android:pathData="
        M49,53 h2 v21 h-2 z
        M53,51 h2 v23 h-2 z
        M57,51 h2 v23 h-2 z
        M61,53 h2 v21 h-2 z"/>

    <!-- Base bar -->
    <path android:fillColor="#FFFFFF" android:pathData="
        M38,74 h32 v4 h-32 z"/>

    <!-- Musical note floating to the upper-right of the harp -->
    <path android:fillColor="#FFFFFF" android:pathData="
        M70,40 a5,4 0 1 1 -10,0 a5,4 0 1 1 10,0
        M69,39 v-12 h3 v12 z"/>
</vector>
